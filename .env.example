# LILIRVE — Supabase environment configuration
#
# Copy this file to .env.local (gitignored — see .gitignore's `.env*.local` rule) and fill in
# real values. Never commit .env.local or any file containing real secrets.
#
# For LOCAL development against the Supabase stack started by `npm run db:start`, run
# `npm run db:status` once the stack is up — it prints the exact values below for your machine
# (the local anon/service_role keys are Supabase's well-known, publicly-documented local dev
# demo keys, not real secrets, but are still kept out of git for hygiene and to avoid confusion
# with production values).
#
# For PRODUCTION/hosted Supabase, copy these three values from your project's
# Settings → API page instead. Nothing in the application code hardcodes `localhost` — which
# Supabase project you're talking to is entirely determined by these environment variables.

# Public — safe to expose to the browser (used by lib/supabase/client.ts and lib/supabase/server.ts).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public — the base URL of THIS app (not the Supabase project). Used to build the confirmation/
# password-reset email links Supabase Auth sends (lib/supabase/config.ts's siteUrl()). For local
# dev this matches `npm run dev`'s default port; in production, use the real deployed domain, and
# make sure it's also added to the hosted Supabase project's Auth → URL Configuration redirect
# allow-list (locally, that's supabase/config.toml's `additional_redirect_urls`).
# Use the SAME host you type in the browser (localhost vs 127.0.0.1 are different cookie jars —
# a mismatch breaks the password-reset link's PKCE verifier cookie). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix this with NEXT_PUBLIC_, never import it into a "use client" component
# or anything that runs in the browser. Used only by lib/supabase/admin.ts for trusted,
# privileged server-side operations (bypasses Row Level Security — see that file's comments).
# Leave unset in any environment that doesn't genuinely need it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# Razorpay (Phase 8) — TEST MODE credentials only for local development. Get these from your
# Razorpay Dashboard → Settings → API Keys (make sure "Test Mode" is toggled on before generating
# keys) and → Settings → Webhooks (create a webhook pointing at /api/payments/webhook, then copy
# the secret shown there — it is generated by Razorpay, not something you choose yourself).
# NEVER use live/production keys here. NEVER commit real values of any of these three.
#
# All three are server-only by design (lib/payments/config.ts) — none are prefixed
# NEXT_PUBLIC_. RAZORPAY_KEY_ID is not secret by Razorpay's own design (Checkout.js needs it in
# the browser), but the app hands it to the client itself inside the /api/payments/checkout JSON
# response rather than baking it into the client bundle via a NEXT_PUBLIC_ var, so it's kept here
# unprefixed too, alongside the two values that ARE genuinely secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
